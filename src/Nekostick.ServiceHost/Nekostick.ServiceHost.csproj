<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nekostick.ServiceHost</AssemblyName>
    <RootNamespace>Nekostick.ServiceHost</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Plugin-style output: private dependencies land next to the extension dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nekolla.Nekostick.Contracts" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <WebUiRoot>$(MSBuildThisFileDirectory)..\..\webui</WebUiRoot>
    <WebUiIndex>$(WebUiRoot)\dist\index.html</WebUiIndex>
  </PropertyGroup>

  <ItemGroup>
    <WebUiInputs Include="$(WebUiRoot)\src\**\*;$(WebUiRoot)\index.html;$(WebUiRoot)\vite.config.ts;$(WebUiRoot)\package.json;$(WebUiRoot)\pnpm-lock.yaml" />
  </ItemGroup>

  <Target
    Name="BuildSvchostWebUi"
    BeforeTargets="AddSvchostWebUiResource"
    Inputs="@(WebUiInputs)"
    Outputs="$(WebUiIndex)"
    Condition="'$(SVCHOST_SKIP_WEBUI_BUILD)' != '1'">
    <Exec WorkingDirectory="$(WebUiRoot)" Command="pnpm install --frozen-lockfile" />
    <Exec WorkingDirectory="$(WebUiRoot)" Command="pnpm build" />
  </Target>

  <Target
    Name="ValidateSkippedSvchostWebUi"
    BeforeTargets="AddSvchostWebUiResource"
    Condition="'$(SVCHOST_SKIP_WEBUI_BUILD)' == '1'">
    <Error
      Condition="!Exists('$(WebUiIndex)')"
      Text="SVCHOST_SKIP_WEBUI_BUILD=1 requires the prebuilt WebUI at $(WebUiIndex)." />
  </Target>
  <Target Name="AddSvchostWebUiResource" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Include="$(WebUiIndex)" LogicalName="Nekostick.ServiceHost.webui.index.html" />
    </ItemGroup>
  </Target>

</Project>
